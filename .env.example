# Sao chép thành `.env` để chạy cục bộ. KHÔNG commit `.env`.
# Giá trị dưới đây chỉ dành cho dev; staging/production lấy từ secret manager.

ENVIRONMENT=dev
LOG_LEVEL=INFO

# CSDL — ứng dụng dùng vai trò app_api/app_worker; migration dùng migrator (xem db/init/01-roles.sql)
DATABASE_URL=postgresql+psycopg://docchat_api:docchat_dev@localhost:5432/docchat
MIGRATOR_DATABASE_URL=postgresql+psycopg://migrator:docchat_dev@localhost:5432/docchat

# Chiều vector phụ thuộc mô hình embedding [TBD: OQ-008, OQ-012]; đổi sau khi có dữ liệu cần re-embed
EMBEDDING_DIM=1024
HNSW_M=16
HNSW_EF_CONSTRUCTION=64

# Object storage (MinIO khi chạy docker compose)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=docchat-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Nhà cung cấp ngoài: mặc định adapter giả lập, chọn thật sau khi OQ-012/013 được chốt
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=fake
# LLM_API_KEY=
# EMBEDDING_API_KEY=

# Xác thực [TBD: OQ-014]: dev (HS256, khóa chung — bị CHẶN ở staging/prod) hoặc oidc (JWKS của IdP)
AUTH_PROVIDER=dev
JWT_SECRET=dev-only-change-me
# OIDC_JWKS_URL=https://idp.example/.well-known/jwks.json
# OIDC_ISSUER=https://idp.example
# OIDC_AUDIENCE=docchat

# Lưu tệp: memory (chỉ dev/test, mất dữ liệu khi khởi động lại) hoặc s3 (cần task C1)
STORAGE_BACKEND=memory

# Origin của SPA nếu khác origin với API (phân tách bằng dấu phẩy). Mặc định rỗng: dùng proxy cùng origin
# CORS_ORIGINS=http://localhost:5173
TELEMETRY_SALT=dev-only-change-me

# Quan sát (tùy chọn)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Thời gian cache app_config (giây)
APP_CONFIG_TTL_SECONDS=30
